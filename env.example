# Update and cp env.example .env

# MongoDB Configuration
# Local dev (API on host): use localhost
# Docker (API in container): use host.docker.internal to reach MongoDB on the host
MONGODB_URI=mongodb://username:password@localhost:27017/?authSource=admin&directConnection=true
MONGODB_DB=pensive

# LLM Configuration
# AI gateway OpenAI Responses API endpoint (Pensive uses the Responses API, not
# Chat Completions, to work correctly with reasoning models). Set the full
# endpoint (ending in /responses) or just the base .../v1 and Pensive appends it.
LLM_URI=https://ai-gateway.corp.mongodb.com/openai/v1/chat/completions
LLM_MODEL=gpt-5.6-luna
# Sent as `Authorization: Bearer <LLM_KEY>`.
LLM_KEY=YOURKEY

# Embedding Configuration
LLM_EMBEDDING_URI=https://ai.mongodb.com/v1/embeddings
LLM_EMBEDDING_MODEL=voyage-4-lite
LLM_EMBEDDING_KEY=YOURKEY
# Used for creating vector indexes
EMBEDDING_DIMENSIONS=1024

# Optional: enables Voyage reranking of retrieved memories. Leave empty to rank
# by vector similarity only (no rerank).
# VOYAGE_API_KEY=

# Optional fallback for curl/local testing without OpenWebUI session headers
# Identity pin: when set, ALL clients share this memory scope (wins over
# forwarded OpenWebUI user headers and body user). Leave empty to scope
# memory per forwarded user.
# USER_ID=default

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=YOURKEY
LANGSMITH_PROJECT="pensive"
# Agent lab: where test-agent file workspaces are created (per agent id).
PENSIVE_AGENT_WORKSPACES=~/.pensive/agent-workspaces

# Host projects directory mounted read-only into the container at /projects
# (default: $HOME/projects — includes the OKF bundle). Pensive agents can
# project_list / project_read files here. Set the host dir with PROJECTS_HOST_DIR
# in the shell before `docker compose up`.
# PENSIVE_PROJECTS_ROOT=/projects
