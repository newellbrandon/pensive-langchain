# Update and cp env.example .env

# MongoDB Configuration
# Local dev (API on host): use localhost
# Docker (API in container): use host.docker.internal to reach MongoDB on the host
MONGODB_URI=mongodb://username:password@localhost:27017/?authSource=admin&directConnection=true
MONGODB_DB=pensive

# LLM Configuration
# AI gateway OpenAI Responses API endpoint (Pensive uses the Responses API, not
# Chat Completions, to work correctly with reasoning models). Set the full
# endpoint (ending in /responses) or just the base .../v1 and Pensive appends it.
LLM_URI=https://ai-gateway.corp.mongodb.com/openai/v1/responses
LLM_MODEL=gpt-5.6-luna
# Sent as `Authorization: Bearer <LLM_KEY>`.
LLM_KEY=YOURKEY

# Embedding Configuration
LLM_EMBEDDING_URI=https://ai.mongodb.com/v1/embeddings
LLM_EMBEDDING_MODEL=voyage-4-lite
LLM_EMBEDDING_KEY=YOURKEY
# Used for creating vector indexes
EMBEDDING_DIMENSIONS=1024

# Optional fallback for curl/local testing without OpenWebUI session headers
# USER_ID=demo-user

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=YOURKEY
LANGSMITH_PROJECT="pensive"